local function getRecentMessagePlayers()
    local today = os.date("!%Y-%m-%d", os.time())
    local data = apiReq("/chat/" .. today .. ".json?orderBy=%22t%22&limitToLast=50", "GET")
    if not data or type(data) ~= "table" then return {} end

    local list = {}
    for _, msg in pairs(data) do
        if type(msg) == "table" then table.insert(list, msg) end
    end
    table.sort(list, function(a, b) return (tonumber(a.t) or 0) > (tonumber(b.t) or 0) end)

    local users = {}
    local seen = {}
    for _, m in ipairs(list) do
        if m.u and m.u ~= "" and not m.h then
            local username = tostring(m.u)
            local key = username:lower()
            if key ~= LocalPlayer.Name:lower() and not seen[key] then
                seen[key] = true
                table.insert(users, {
                    user = username,
                    displayName = tostring(m.d or username),
                    jobId = tostring(m.j or ""),
                    time = tonumber(m.t) or 0
                })
            end
        end
    end
    return users
end

