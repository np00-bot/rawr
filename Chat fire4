-- [ JOIN REQUEST CONFIRMATION ]
local JoinRequestExcluded = {
    ["nothing_sam00"] = true,
    ["mob_one0"] = true,
    ["kausarali2"] = true
}

local function isJoinRequestExcluded(username)
    return JoinRequestExcluded[string.lower(tostring(username or ""))] == true
end

local function sendJoinResponse(targetUser, response)
    local binary = usernameToBinary(targetUser)
    if not binary then return end

    if response == "allow" then
        -- Send our JobId to the requester
        sendFirebaseMessage(
            "jr" .. binary .. ":" .. game.JobId,
            false,
            targetUser,
            true
        )

    elseif response == "reject" then
        sendFirebaseMessage(
            "jdeny" .. binary,
            false,
            targetUser,
            true
        )

    elseif response == "timeout" then
        sendFirebaseMessage(
            "jtimeout" .. binary,
            false,
            targetUser,
            true
        )
    end
end

local function showJoinRequestNotification(requester)
    local answered = false

    local callback = Instance.new("BindableFunction")

    callback.OnInvoke = function(button)
        if answered then return end
        answered = true

        if button == "Allow" then
            sendJoinResponse(requester, "allow")
            displayMessage(
                "System",
                "Join request from @" .. requester .. " allowed."
            )

        elseif button == "Reject" then
            sendJoinResponse(requester, "reject")
            displayMessage(
                "System",
                "Join request from @" .. requester .. " rejected."
            )
        end
    end

    local ok = pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Join Request",
            Text = "@" .. requester .. " wants to join your server.",
            Duration = 20,
            Button1 = "Allow",
            Button2 = "Reject",
            Callback = callback
        })
    end)

    if not ok then
        callback:Destroy()
        return
    end

    -- If neither button is pressed within 20 seconds
    task.delay(20, function()
        if answered then return end
        answered = true

        sendJoinResponse(requester, "timeout")

        callback:Destroy()

        displayMessage(
            "System",
            "Join request from @" .. requester .. " timed out."
        )
    end)
end


-- [ MAIN POLLING LOOP ]
local function pollMessages()
    while State.IsPolling do
        local timeSinceLastMsg = os.clock() - State.LastMessageAt
        local pollRate = (timeSinceLastMsg >= CONFIG.IdleAfter) and CONFIG.IdlePollRate or CONFIG.ActivePollRate
        task.wait(pollRate)

        local syncRes = apiReq("/sync.json", "GET")
        local globalSync = tonumber(syncRes)

        if globalSync and globalSync > State.LastSyncTime then
            local today = os.date("!%Y-%m-%d", os.time())
            local queryUrl = "/chat/" .. today .. ".json?orderBy=%22t%22&startAt=" .. (State.LastSyncTime + 1) .. "&limitToFirst=" .. CONFIG.MaxMessageFetch
            local data = apiReq(queryUrl, "GET")

            if data and type(data) == "table" then
                local newMessages = {}
                for _, msgData in pairs(data) do
                    table.insert(newMessages, msgData)
                end
                table.sort(newMessages, function(a, b) return (tonumber(a.t) or 0) < (tonumber(b.t) or 0) end)

                if #newMessages > 0 then
                    State.LastMessageAt = os.clock()
                end

                for _, m in ipairs(newMessages) do
                    local msgTime = tonumber(m.t) or 0
                    if msgTime > State.LastSyncTime then
                        State.LastSyncTime = msgTime
                        State.KnownUsers[m.u:lower()] = m.u
                        local msgText = m.m or ""

