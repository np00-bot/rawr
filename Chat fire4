local function getPlayer(nameStr)
    if not nameStr or nameStr == "" then return nil end
    local lowerName = nameStr:lower()
    for _, p in pairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1, #lowerName) == lowerName or p.DisplayName:lower():sub(1, #lowerName) == lowerName then
            return p
        end
    end
end

local function sendToRobloxChat(msg)
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if channel then channel:SendAsync(msg) end
    else
        local events = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
        if events and events:FindFirstChild("SayMessageRequest") then
            events.SayMessageRequest:FireServer(msg, "All")
        end
    end
end

