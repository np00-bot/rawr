local function processCommand(text)
    local cleanStr = text:match("^%s*[/,;:!.]?%s*(.-)%s*$")
    if not cleanStr or cleanStr == "" then return false end

    local lower = cleanStr:lower()

    -- Chat disable commands
    if lower == "unchat"
        or lower == "nochat"
        or lower == "disable chat"
        or lower == "chat off"
        or lower == "chat stop" then

        CommandList.unchat()
        return true
    end

    local cmd, args = lower:match("^(%S+)%s*(.*)$")

    if cmd and CommandList[cmd] then
        pcall(CommandList[cmd], args)
        return true
    end

    return false
end

local function processCommand(text)
