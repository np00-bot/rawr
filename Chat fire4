local function sendPrivateMessage()
    local text = TextBox.Text
    if not text or text == "" then return end
    if processCommand(text) then
        TextBox.Text = ""
        return
    end

    local lowerText = text:gsub("%s+", ""):lower()
    TextBox.Text = ""

    if lowerText == "!cmds" then
        displayMessage("System", "Commands:\n- fly, unfly\n- speed [num], jumppower [num]\n- spin, unspin, orbit [user], unorbit\n- view [user], unview, tp [user]\n- invisible, visible, noclip, clip, sit, nosit\n- copyserverid\n- !p (private chat)\n- !j (join player)")
        return
    elseif lowerText == "!server" or lowerText == "!global" then
        State.ChatMode = lowerText:sub(2)
        displayMessage("System", "Chat mode switched to " .. State.ChatMode:upper() .. ".")
        return
    end

    TextBox.PlaceholderText = " Sending..."
    task.spawn(function()
        sendFirebaseMessage(text, State.PrivateTarget ~= nil, State.PrivateTarget, false)
        TextBox.PlaceholderText = " press ; to type.."
    end)
end

