-- [ UTILITIES ]
local function generatePushID()
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    local id = ""
    for _ = 1, 20 do
        local r = math.random(1, #chars)
        id = id .. string.sub(chars, r, r)
    end
    return id
end

local function create(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    return inst
end

local function toLowerKeys(tbl)
    local newTbl = {}
    if type(tbl) == "table" then
        for k, v in pairs(tbl) do
            newTbl[type(k) == "string" and k:lower() or k] = v
        end
    end
    return newTbl
end

local function usernameToBinary(username)
    if type(username) ~= "string" or username == "" then return nil end
    local out = {}
    for i = 1, #username do
        local byte = string.byte(username, i)
        local bits = {}
        for b = 7, 0, -1 do
            bits[#bits + 1] = (math.floor(byte / (2^b)) % 2 == 1) and "1" or "0"
        end
        out[i] = table.concat(bits)
    end
    return table.concat(out)
end

local function binaryToUsername(binary)
    if type(binary) ~= "string" or binary == "" or binary:find("[^01]") then return nil end
    if #binary % 8 ~= 0 then return nil end
    local chars = {}
    for i = 1, #binary, 8 do
        local byteString = binary:sub(i, i + 7)
        local byte = tonumber(byteString, 2)
        if not byte or byte < 32 or byte > 126 then return nil end
        chars[#chars + 1] = string.char(byte)
    end
    return table.concat(chars)
end

-- [ NETWORKING ]
local function apiReq(path, method, body)
    local ok, res = pcall(req, {
        Url = CONFIG.FirebaseUrl .. path,
        Method = method or "GET",
        Headers = {
            ["Content-Type"] = "application/json",
            ["User-Agent"] = "Roblox/WinInet"
        },
        Body = body and HttpService:JSONEncode(body) or nil
    })
    if ok and res and res.StatusCode == 200 and res.Body ~= "null" then
        local valid, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        return valid and data or nil
    end
    return nil
end

local function sendFirebaseMessage(msgText, isPrivate, targetUser, isHidden)
    local exactTime = DateTime.now().UnixTimestampMillis
    local currentTime = os.time()
    local today = os.date("!%Y-%m-%d", currentTime)
    local yesterday = os.date("!%Y-%m-%d", currentTime - 86400)
    local pushID = generatePushID()

    local payload = {
        ["chat/" .. today .. "/" .. pushID] = {
            u = LocalPlayer.Name,
            d = LocalPlayer.DisplayName,
            m = msgText,
            j = game.JobId,
            p = targetUser,
            h = isHidden or false,
            t = exactTime
        },
        ["sync"] = exactTime
    }

    task.spawn(function()
        apiReq("/.json", "PATCH", payload)
        apiReq("/chat/" .. yesterday .. ".json", "DELETE")
    end)
end

