local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then
	Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
	LocalPlayer = Players.LocalPlayer
end

local httpRequest = request or (syn and syn.request) or (http and http.request)

-- Firebase database URLs (normalized without trailing slash)
local FIREBASE_DATABASES = {
	"https://roblox-chat-112d0-default-rtdb.firebaseio.com",
	"https://roblox-chat-2-default-rtdb.firebaseio.com"
}

local day = tonumber(os.date("!%d")) or 1
local FirebaseURL = FIREBASE_DATABASES[day <= 15 and 1 or 2]

local function getUtcDateString()
	return os.date("!%Y-%m-%d")
end

local function fetchLatest10()
	if not httpRequest then
		warn("No HTTP request function available.")
		return nil
	end

	local today = getUtcDateString()
	local url = FirebaseURL .. "/chat/" .. today .. ".json?orderBy=%22t%22&limitToLast=10"

	local success, response = pcall(function()
		return httpRequest({
			Url = url,
			Method = "GET"
		})
	end)

	if not success or not response or response.StatusCode ~= 200 then
		warn("Failed to fetch Firebase messages")
		return nil
	end

	local decodedSuccess, data = pcall(function()
		return HttpService:JSONDecode(response.Body)
	end)

	if not decodedSuccess or type(data) ~= "table" then
		return nil
	end

	return data
end

local function isSystemMessage(message)
	return message == "Joined"
		or message:match("^p[01]+$") ~= nil
		or message:match("^j[01]+$") ~= nil
		or message:match("^jr[01]+:") ~= nil
		or message:match("^jdeny[01]+$") ~= nil
		or message:match("^jtimeout[01]+$") ~= nil
end

local function sendJoinedMessage(targetJobId)
	if not httpRequest or not targetJobId or targetJobId == "" then
		return
	end

	local exactTime = DateTime.now().UnixTimestampMillis
	local today = getUtcDateString()

	local payload = {
		["chat/" .. today .. "/" .. HttpService:GenerateGUID(false)] = {
			u = LocalPlayer.Name,
			d = LocalPlayer.DisplayName,
			m = "Joined",
			j = targetJobId,
			p = "",
			h = true,
			t = exactTime
		},
		sync = exactTime
	}

	pcall(function()
		httpRequest({
			Url = FirebaseURL .. ".json",
			Method = "PATCH",
			Headers = {
				["Content-Type"] = "application/json"
			},
			Body = HttpService:JSONEncode(payload)
		})
	end)
end

local function findLatestEligibleJobId()
	local messages = fetchLatest10()
	if not messages then
		return nil
	end

	local sorted = {}
	for _, message in pairs(messages) do
		if type(message) == "table" then
			table.insert(sorted, message)
		end
	end

	table.sort(sorted, function(a, b)
		return (tonumber(a.t) or 0) > (tonumber(b.t) or 0)
	end)

	for _, message in ipairs(sorted) do
		local username = message.u
		local text = message.m
		local jobId = message.j

		local valid =
			type(username) == "string"
			and type(text) == "string"
			and text:match("%S") ~= nil
			and type(jobId) == "string"
			and jobId ~= ""
			and username:lower() ~= LocalPlayer.Name:lower()
			and message.h ~= true
			and (message.p == nil or message.p == "")
			and not isSystemMessage(text)

		if valid then
			return jobId, username
		end
	end

	return nil, nil
end

local function createNotificationGui()
	local existing = CoreGui:FindFirstChild("NPSearchNotification")
	if existing then
		existing:Destroy()
	end

	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "NPSearchNotification"
	ScreenGui.ResetOnSpawn = false

	local parentOk = pcall(function()
		ScreenGui.Parent = CoreGui
	end)
	if not parentOk or not ScreenGui.Parent then
		ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	end

	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(0, 260, 0, 85)
	Frame.Position = UDim2.new(0.5, -130, 0.8, 0)
	Frame.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
	Frame.Parent = ScreenGui

	Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 10)

	local Title = Instance.new("TextLabel")
	Title.Size = UDim2.new(1, -20, 0, 35)
	Title.Position = UDim2.new(0, 10, 0, 5)
	Title.BackgroundTransparency = 1
	Title.Text = "Searching for NP server..."
	Title.TextColor3 = Color3.new(1, 1, 1)
	Title.TextSize = 15
	Title.Font = Enum.Font.GothamMedium
	Title.TextTruncate = Enum.TextTruncate.AtEnd
	Title.Parent = Frame

	local Cancel = Instance.new("TextButton")
	Cancel.Size = UDim2.new(1, -20, 0, 30)
	Cancel.Position = UDim2.new(0, 10, 0, 45)
	Cancel.BackgroundColor3 = Color3.fromRGB(235, 64, 52)
	Cancel.Text = "CANCEL"
	Cancel.TextColor3 = Color3.new(1, 1, 1)
	Cancel.TextSize = 13
	Cancel.Font = Enum.Font.GothamBold
	Cancel.Parent = Frame

	Instance.new("UICorner", Cancel).CornerRadius = UDim.new(0, 7)

	return ScreenGui, Title, Cancel
end

local function startSearchAndTeleport()
	local ScreenGui, Title, Cancel = createNotificationGui()
	local cancelled = false
	local targetJobId = nil

	Cancel.MouseButton1Click:Connect(function()
		if cancelled then
			return
		end
		cancelled = true

		if targetJobId then
			sendJoinedMessage(targetJobId)
		end

		ScreenGui:Destroy()
	end)

	local foundJobId, foundUsername = findLatestEligibleJobId()
	if cancelled then
		return
	end

	if not foundJobId then
		warn("No eligible person found in the latest 10 messages.")
		Title.Text = "No NP server found."
		task.wait(2)
		if ScreenGui.Parent then
			ScreenGui:Destroy()
		end
		return
	end

	targetJobId = foundJobId

	if targetJobId == game.JobId then
		warn("Latest eligible person is already in this server. Stopping.")
		Title.Text = "Already in target server."
		task.wait(2)
		if ScreenGui.Parent then
			ScreenGui:Destroy()
		end
		return
	end

	-- 15-second countdown before teleporting (user can click CANCEL)
	for i = 15, 1, -1 do
		if cancelled or not ScreenGui.Parent then
			return
		end

		Title.Text = string.format("Joining %s... (%ds)", foundUsername or "NP", i)
		task.wait(1)
	end

	if cancelled then
		return
	end

	if ScreenGui.Parent then
		ScreenGui:Destroy()
	end

	print("Joining:", foundUsername, "Server:", targetJobId)

	local success, err = pcall(function()
		TeleportService:TeleportToPlaceInstance(
			game.PlaceId,
			targetJobId,
			LocalPlayer
		)
	end)

	if not success then
		warn("Teleport failed:", err)
	end
end

startSearchAndTeleport()
